rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /trades/{tradeId} {
      allow read: if true;
      allow write: if false;
    }

    match /live-trades/{tradeId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
    }
  }
}
